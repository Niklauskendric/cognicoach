    os.environ.setdefault("LANGCHAIN_PROJECT", "cognicoach")
    logger.info(
        f"[langsmith] Tracing ENABLED — project="
        f"'{os.environ.get('LANGCHAIN_PROJECT')}'. "
        f"View traces at https://smith.langchain.com"
    )
else:
